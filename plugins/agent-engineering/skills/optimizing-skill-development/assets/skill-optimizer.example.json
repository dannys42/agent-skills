{
  "schema_version": 1,
  "target": "skills/example-skill",
  "distributable": {
    "include": [
      "SKILL.md",
      "agents/**/*.yaml",
      "assets/**/*.json",
      "references/**/*.md",
      "scripts/**/*.py"
    ],
    "exclude": [
      "**/__pycache__/**",
      "**/*.pyc"
    ]
  },
  "commands": {
    "skill-tests": {
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "cwd": ".",
      "timeout_seconds": 120,
      "max_output_bytes": 1048576,
      "network": false,
      "timing_kind": "work"
    }
  },
  "profiles": {
    "quick": ["skill-tests"],
    "content": ["skill-tests"],
    "behavior": ["skill-tests"],
    "importer": ["skill-tests"],
    "full": ["skill-tests"]
  },
  "evaluations": {
    "cases": "tests/evaluation-cases.json",
    "rubric": "tests/evaluation-rubric.json"
  }
}
